# Modele de configuration du front-end.
# Copier en « .env ». Seules les variables VITE_ sont exposees au navigateur,
# et tout ce qui figure ici est PUBLIC : aucune cle secrete.

VITE_API_URL=/api
VITE_STRIPE_PUBLIC_KEY=

# ---------------------------------------------------------------------
#  Support automatise — module 15
# ---------------------------------------------------------------------
# URL du webhook n8n qui recoit les questions du widget de chat.
#
# ABSENTE = WIDGET MASQUE, jamais un widget qui echoue : le support
# automatise est une couche en plus, l'application fonctionne sans.
#
# En developpement, n8n ecoute sur http://localhost:5678 et le chemin est
# celui du noeud Webhook du workflow.
VITE_SUPPORT_WEBHOOK_URL=

# ---------------------------------------------------------------------
# Nom du bot Telegram de support, sans « @ » (module 15).
#
# ABSENT = SECTION « Assistant sur Telegram » MASQUEE dans les Parametres :
# une installation sans bot n'a aucune conversation a rattacher.
# Ce n'est pas un secret — le jeton du bot, lui, ne vit que dans n8n.
VITE_TELEGRAM_BOT=
