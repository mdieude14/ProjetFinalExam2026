# =============================================================
#  MODELE DE CONFIGURATION
#  Copier ce fichier en « .env » et remplir les valeurs.
#  Le fichier .env ne doit JAMAIS etre commite (voir .gitignore).
# =============================================================

# --- Serveur -------------------------------------------------
NODE_ENV=development
PORT=5000
# Origine(s) autorisee(s) par CORS, separees par des virgules.
#
# DEUX ORIGINES EN DEVELOPPEMENT, ET LA SECONDE EST FACILE A OUBLIER :
#   5173  le serveur de developpement Vite
#   4173  `vite preview`, qui sert le BUILD de production en local
#
# Sans la seconde, verifier son build avant deploiement echoue a la connexion
# sur une erreur CORS — et le message accuse l'authentification, pas l'origine.
# En production, ne laisser que le domaine reel du front.
CLIENT_URL=http://localhost:5173,http://localhost:4173

# --- Base de donnees ----------------------------------------
# MongoDB Atlas : mongodb+srv://<user>:<motdepasse>@<cluster>.mongodb.net/sportsocial
MONGO_URI=mongodb+srv://utilisateur:motdepasse@cluster.mongodb.net/sportsocial?retryWrites=true&w=majority

# --- Securite / JWT -----------------------------------------
# Generer des chaines aleatoires longues et DIFFERENTES l'une de l'autre :
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=remplacer_par_une_chaine_aleatoire_de_64_octets
JWT_REFRESH_SECRET=remplacer_par_une_autre_chaine_aleatoire_de_64_octets
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
BCRYPT_SALT_ROUNDS=12

# --- Cloudinary (module 5 : upload des medias) --------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Stripe Connect (module 7 : abonnements premium) --------
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Commission prelevee par la plateforme sur chaque abonnement (en %)
STRIPE_COMMISSION_PCT=15

# --- Reglages de developpement (facultatifs) ----------------
# Neutralises en production : ils n'ont d'effet que si NODE_ENV=development.

# Affiche chaque requete Mongoose dans la console. Tres verbeux, mais c'est le
# seul moyen de voir qu'une page declenche quarante requetes la ou une seule
# suffirait.
MONGOOSE_DEBUG=false

# Reactive les limiteurs de debit en developpement. Ils sont desactives par
# defaut, sans quoi cinq connexions de test suffiraient a se bloquer soi-meme
# pour un quart d'heure. A passer a « true » pour verifier qu'ils fonctionnent.
RATE_LIMIT_DEV=false

# ---------------------------------------------------------------------
#  Support automatise — module 15
# ---------------------------------------------------------------------
# Cle presentee par n8n en en-tete `x-service-key` pour relever les tickets
# escalades. FACULTATIVE : absente, les deux routes de service restent
# fermees et le reste de l'application fonctionne sans changement.
#
# Elle n'ouvre QUE la releve et le marquage. Elle ne donne acces ni aux
# diplomes, ni a la moderation, ni aux comptes — c'est tout l'interet de ne
# pas avoir donne un jeton d'administrateur a l'orchestrateur.
#
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SUPPORT_SERVICE_KEY=

# Cle presentee par l'agent n8n en en-tete `x-agent-key`, EN PLUS du jeton
# de l'utilisateur, quand il enregistre un ticket. Elle atteste que la reponse
# et les outils du ticket viennent bien de l'agent. Sans elle, l'API les ignore
# et le ticket remonte a un humain : un utilisateur ne peut plus ecrire
# lui-meme une fausse reponse d'agent.
#
# DISTINCTE de SUPPORT_SERVICE_KEY : l'API refuse de demarrer si les deux
# ont la meme valeur. L'agent du widget lit du contenu non fiable, il ne doit
# pas detenir la cle qui releve la file des escalades.
#
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SUPPORT_AGENT_KEY=

# ---------------------------------------------------------------------
#  Envoi d'e-mails — mot de passe oublie
# ---------------------------------------------------------------------
# Gmail : activer la validation en deux etapes sur le compte Google, puis
# creer un « mot de passe d'application » sur
#   https://myaccount.google.com/apppasswords
# et le coller dans SMTP_PASS (16 lettres, sans espaces). Ce n'est PAS le
# mot de passe du compte Gmail.
#
# FACULTATIF EN DEVELOPPEMENT : sans SMTP_USER / SMTP_PASS, les e-mails sont
# deposes dans server/.boite-mails/ au lieu d'etre envoyes. Les adresses en
# .local (comptes de test) y sont toujours deposees, jamais envoyees.
# OBLIGATOIRE EN PRODUCTION : l'API refuse de demarrer sans eux.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM="CoachConnect <votre.adresse@gmail.com>"
