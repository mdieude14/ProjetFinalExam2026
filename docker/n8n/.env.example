# ===========================================================================
#  n8n — variables d'environnement
# ===========================================================================
#
#   cp docker/n8n/.env.example docker/n8n/.env
#
# Puis remplir N8N_ENCRYPTION_KEY. Les autres valeurs ont des défauts
# utilisables en développement.
# ===========================================================================

# Chiffre les identifiants que n8n conserve — clé Anthropic, jeton Telegram,
# accès à la boîte mail. À GÉNÉRER UNE FOIS, puis à ne plus changer : une
# nouvelle clé rendrait les identifiants déjà enregistrés illisibles.
#
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
N8N_ENCRYPTION_KEY=

# L'adresse de l'API de CoachConnect n'est PAS une variable d'environnement :
# les nœuds n'ont pas accès à l'environnement (N8N_BLOCK_ENV_ACCESS_IN_NODE),
# pour ne pas pouvoir lire N8N_ENCRYPTION_KEY. Elle est écrite dans la
# configuration du workflow — nœud « Préparer la demande » :
#   http://host.docker.internal:5000/api

# URL publique des webhooks. En développement, l'adresse d'un tunnel
# (cloudflared, ngrok) — le widget du navigateur doit pouvoir joindre n8n.
WEBHOOK_URL=http://localhost:5678/

# Nom d'hôte et protocole annoncés par n8n. À adapter derrière un tunnel.
N8N_HOST=localhost
N8N_PROTOCOL=http
