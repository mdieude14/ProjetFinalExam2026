# ===========================================================================
#  LES VARIABLES DE L'API, SUR LE VPS
# ===========================================================================
#
#   cp api.env.example api.env     puis renseigner
#
# CE FICHIER EST UN GABARIT, versionné et sans aucune valeur. Le `api.env`
# qui en découle porte tous les secrets de production et n'est PAS suivi par
# git — la règle `.env` du dépôt le couvre.
#
# POURQUOI UN FICHIER SÉPARÉ DU `.env` DE COMPOSE : celui-là sert aux
# domaines et au relais, et compose l'interpole. Celui-ci est transmis TEL
# QUEL au conteneur, sans interpolation — donc sans le piège du doublement
# des `$`.
#
# ---------------------------------------------------------------------------
#  CE QUI EST DÉJÀ POSÉ PAR LA COMPOSITION, ET QU'IL NE FAUT PAS REMETTRE
# ---------------------------------------------------------------------------
#
#   NODE_ENV=production
#   PORT=5000
#   N8N_WEBHOOK_TELEGRAM     déduite de N8N_DOMAINE
#
# ===========================================================================


# ---------------------------------------------------------------------------
#  LA BASE
# ---------------------------------------------------------------------------
# La chaîne Atlas, celle qui a servi à la migration.
#
#   ⚠️ LE NOM DE LA BASE DOIT Y FIGURER, avant le « ? » :
#        …mongodb.net/sportsocial?retryWrites=true&w=majority
#
#   Sans lui, le pilote écrit dans la base « test » et l'application paraît
#   VIDE sans qu'aucune erreur ne remonte. C'est le piège le plus coûteux de
#   la mise en place d'Atlas.
#
#   Et autoriser l'IP du VPS dans « Network Access » d'Atlas : l'IP du poste
#   de développement n'autorise que le poste.
MONGO_URI=


# ---------------------------------------------------------------------------
#  LES ORIGINES, ET LE PIÈGE DE L'ORDRE
# ---------------------------------------------------------------------------
#
# ⚠️ LE DOMAINE VERCEL EN PREMIER. Cette variable sert DEUX choses :
#
#     CORS et Socket.IO          toute la liste
#     adresse publique           la PREMIÈRE valeur seulement
#
# La première valeur est employée par Stripe Checkout, par l'onboarding
# Connect et par LES LIENS DES COURRIELS de réinitialisation. Mise en second,
# ces trois parcours renverraient l'utilisateur sur l'autre domaine — sans
# qu'aucune erreur ne remonte au serveur.
CLIENT_URL=

# L'adresse publique de l'application, explicitement. Elle existe pour ne plus
# dépendre de l'ordre de CLIENT_URL.
PUBLIC_URL=


# ---------------------------------------------------------------------------
#  LES JETONS
# ---------------------------------------------------------------------------
# NEUFS, et NON ceux du poste de développement.
#
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
#
# ⚠️ LES DEUX DOIVENT DIFFÉRER. Toute la séparation des deux jetons repose sur
# cette inégalité : si un seul secret fuite, l'autre type de jeton reste
# inforgeable. `npm run verifier:deploiement` le contrôle.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=


# ---------------------------------------------------------------------------
#  LES FICHIERS
# ---------------------------------------------------------------------------
# Les mêmes qu'en local : le compte Cloudinary est déjà actif.
#
#   ⚠️ SANS CES TROIS VALEURS, le stockage retombe sur le disque LOCAL du
#   conteneur — et un conteneur recréé perd tout ce qui y a été téléversé,
#   sans un mot d'erreur.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=


# ---------------------------------------------------------------------------
#  LES PAIEMENTS
# ---------------------------------------------------------------------------
# En mode RÉEL pour la production. Voir docs/DEPLOIEMENT.md §5 : six gestes,
# dont la déclaration de l'endpoint avec SES NEUF ÉVÉNEMENTS.
#
#   Le secret de webhook est celui de l'ENDPOINT du tableau de bord Stripe,
#   et non celui qu'affiche la CLI en développement.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=


# ---------------------------------------------------------------------------
#  LE SUPPORT ET TELEGRAM
# ---------------------------------------------------------------------------
# ⚠️ LES DEUX CLÉS DU SUPPORT DOIVENT DIFFÉRER, et le serveur refuse de
# démarrer si elles sont égales. La clé de service ouvre la file des
# escalades ; la clé d'agent authentifie ce que l'agent du widget écrit, et
# cet agent est exposé à du contenu non fiable.
#
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SUPPORT_SERVICE_KEY=
SUPPORT_AGENT_KEY=

# Le jeton du bot. Le back-end va CHERCHER les messages (`getUpdates`), donc
# aucun tunnel ni adresse publique n'est requis pour l'entrant.
TELEGRAM_BOT_TOKEN=


# ---------------------------------------------------------------------------
#  L'ENVOI DE COURRIELS — EXIGÉ EN PRODUCTION
# ---------------------------------------------------------------------------
# Sans lui, « mot de passe oublié » répond normalement et AUCUN courriel ne
# part jamais : la personne attend un lien qui n'arrivera pas. Le serveur
# refuse de démarrer en production sans l'une des deux voies.
#
#   OAuth2, recommandé : SMTP_USER + les trois GOOGLE_OAUTH_*
#   ou mot de passe d'application : SMTP_USER + SMTP_PASS
SMTP_USER=
MAIL_FROM=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
