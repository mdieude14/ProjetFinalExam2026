# ===========================================================================
#  Caddy — le seul service exposé, et il ne laisse passer que les webhooks
# ===========================================================================
#
# CE FICHIER EST LA MESURE DE SÉCURITÉ DU DÉPLOIEMENT.
#
# n8n publié tel quel sur Internet offre son ÉDITEUR au monde entier. Or
# l'image est épinglée en 1.121.3, une version choisie pour un poste LOCAL :
# le plus petit pas qui sortait de deux CVE exploitables par un compte
# authentifié. Ce raisonnement tenait derrière un pare-feu domestique ; il ne
# tient plus face à Internet.
#
#   D'OÙ LA RÈGLE ICI : on ouvre les chemins dont un service EXTERNE a besoin,
#   et rien d'autre. Tout le reste demande un mot de passe.
#
# ---------------------------------------------------------------------------
{
	# Adresse pour les avis d'expiration de Let's Encrypt. Sans elle, Caddy
	# obtient quand même le certificat, mais personne n'est averti si le
	# renouvellement échoue — et il échoue toujours un dimanche.
	email {$ADMIN_COURRIEL}
}

{$N8N_DOMAINE} {
	encode zstd gzip

	# -----------------------------------------------------------------------
	#  MCP D'INSTANCE (connecteur Claude) — ajouté le 11/11/2026
	# -----------------------------------------------------------------------
	#
	# Claude s'enregistre seul (OAuth, enregistrement dynamique) puis appelle
	# /mcp-server/http avec un jeton. Derrière `basic_auth`, ces appels de
	# SERVEUR à serveur reçoivent un 401 de Caddy et l'enregistrement échoue
	# (« Couldn't register with n8n's sign-in service »). Ils restent protégés
	# par n8n lui-même : sans jeton OAuth valide, /mcp-server répond 401.
	# La page de consentement, elle, est ouverte par TON navigateur : elle
	# reste derrière le mot de passe de l'éditeur.
	@mcp path /mcp-server/* /mcp-oauth/* /.well-known/oauth-authorization-server* /.well-known/oauth-protected-resource*
	handle @mcp {
		reverse_proxy n8n:5678
	}

	# -----------------------------------------------------------------------
	#  CE QUI EST PUBLIC, ET UNIQUEMENT CELA
	# -----------------------------------------------------------------------
	#
	#   /webhook/*        les flux appelés par Telegram, le widget, l'API
	#   /webhook-test/*   le même, en mode « écouter une fois » dans l'éditeur
	#   /healthz          la sonde de disponibilité
	#   /rest/oauth2-credential/callback
	#                     le rappel de Google. C'est le NAVIGATEUR de
	#                     l'exploitant qui l'appelle, mais Google l'y renvoie
	#                     par une redirection : derrière un mot de passe, la
	#                     fenêtre d'autorisation se refermerait sur une
	#                     demande d'identifiants au plus mauvais moment.
	@public path /webhook/* /webhook-test/* /healthz /rest/oauth2-credential/callback
	handle @public {
		reverse_proxy n8n:5678
	}

	# -----------------------------------------------------------------------
	#  TOUT LE RESTE : l'éditeur, l'API REST, les réglages
	# -----------------------------------------------------------------------
	#
	# `basic_auth` attend une empreinte bcrypt, jamais un mot de passe en
	# clair — la générer ainsi, sur le VPS :
	#
	#   docker run --rm caddy:2.11.9-alpine caddy hash-password --plaintext 'le-mot-de-passe'
	#
	# L'empreinte obtenue va dans EDITEUR_EMPREINTE du fichier .env.
	#
	#   ATTENTION AU `$` : dans un `.env` lu par docker compose, une empreinte
	#   bcrypt commence par `$2a$...` et chaque `$` doit être DOUBLÉ (`$$`),
	#   sinon compose tente de l'interpréter comme une variable et transmet
	#   une empreinte tronquée. Le symptôme est un mot de passe correct qui
	#   est refusé, sans rien dans le journal.
	handle {
		basic_auth {
			{$EDITEUR_UTILISATEUR} {$EDITEUR_EMPREINTE}
		}
		# 12/11/2026 : n8n repond 401 quand on n'est pas encore connecte a n8n
		# (GET /rest/login). Le navigateur prend ce 401 pour un refus du mot de
		# passe de CETTE fenetre, l'oublie, et les fichiers de la page suivante
		# arrivent sans mot de passe : page blanche, impossible de se connecter.
		# Ici, et seulement ici, un 401 de n8n devient 403 : le navigateur garde
		# le mot de passe, et n8n affiche normalement sa page de connexion.
		reverse_proxy n8n:5678 {
			@n8n_401 status 401
			handle_response @n8n_401 {
				copy_response 403
			}
		}
	}
}

# ===========================================================================
#  L'API DE COACHCONNECT — et le WebSocket passe sans un réglage de plus
# ===========================================================================
#
# POURQUOI IL N'Y A RIEN À CONFIGURER POUR SOCKET.IO.
#
# `reverse_proxy` de Caddy relaie nativement la montée en WebSocket : il
# reconnaît l'en-tête `Upgrade` et bascule la connexion. C'est exactement ce
# que Vite devait faire en développement avec `ws: true` — ici, c'est le
# comportement par défaut, et son absence était la panne déroutante du
# module 11.
#
# Et l'API tient son Socket.IO sur LE MÊME port que son HTTP
# (`initialiserSockets(serveurHttp)` réutilise le serveur d'Express) : un
# seul `reverse_proxy` suffit donc pour les deux.
#
#   ÉPROUVÉ : le point d'entrée rend
#   `{"sid":"…","upgrades":["websocket"],…}` — le serveur annonce lui-même
#   qu'il accepte la montée.
#
# ---------------------------------------------------------------------------
#  ET ICI, TOUT EST PUBLIC — c'est l'inverse du bloc n8n
# ---------------------------------------------------------------------------
#
# n8n n'ouvre que ses webhooks parce que son éditeur n'a rien à faire sur
# Internet. L'API, elle, EST le service : ses routes sont protégées par
# leurs propres jetons, par `helmet`, par le limiteur de débit en couches
# (global sur /api, puis dédié à /register, /login et /refresh) et par CORS,
# qui ne laisse entrer que les origines de `CLIENT_URL`.
{$API_DOMAINE} {
	encode zstd gzip

	# ---------------------------------------------------------------------
	#  L'ADRESSE RÉELLE DU VISITEUR : RIEN À AJOUTER, ET J'AI FAILLI ME
	#  TROMPER
	# ---------------------------------------------------------------------
	#
	# L'enjeu est réel : derrière un relais, si l'API voit l'adresse de Caddy
	# au lieu de celle du visiteur, LE LIMITEUR DE DÉBIT NE SERT PLUS À RIEN —
	# le quota de cinq tentatives de `/login` serait partagé par tout
	# Internet, donc épuisé par n'importe qui, pour tout le monde.
	#
	# Premier jet : `header_up X-Real-IP {remote_host}`. VÉRIFIÉ, C'ÉTAIT
	# INUTILE, et pour deux raisons qui se complètent :
	#
	#   · `app.js:27` fait déjà `app.set('trust proxy', 1)` — Express lit donc
	#     l'adresse dans `X-Forwarded-For`, et PAS dans `X-Real-IP` ;
	#   · `reverse_proxy` de Caddy pose `X-Forwarded-For` TOUT SEUL.
	#
	#   LA CHAÎNE EST DONC DÉJÀ COMPLÈTE. Mon en-tête aurait été posé, lu par
	#   personne, et il aurait eu l'air de régler le problème.
	#
	# *Un réglage qui ne sert à rien est pire qu'un réglage absent : il fait
	# croire que la question est traitée.*
	reverse_proxy api:5000
}
